theme = Catppuccin Mocha
custom-shader-animation = always
#custom-shader = ./shaders/sahaj-b/cursor_warp.glsl
#custom-shader = ./shaders/sahaj-b/ripple_cursor.glsl
custom-shader = ./shaders/KroneCorylus/cursor_blaze_tapered.glsl

macos-titlebar-style = transparent

# cursor
# maroon
cursor-color = #eba0ac
# teal
#cursor-color = #81c8be
# blue
#cursor-color = #8caaee
cursor-style = block
cursor-style-blink = false
# shell integration sends DECSCUSR sequences that override cursor-style/blink; disable it.
# ssh-terminfo installs xterm-ghostty on remote hosts; ssh-env is its fallback. these
# merge with the defaults (no-sudo,title,path) rather than replacing them.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# the nix store is read-only, so in-app updates can't apply; update via `just update`
auto-update = off
